  "fetchOHLCV": {
    "unified": [
      "publicGetProductsIdCandles"
    ],
    "has": true,
    "mapping_complete": true,
    "verification": "verified",
    "descriptor": {
      "async": true,
      "description": "Fetch Coinbase Exchange product candles.",
      "errors": null,
      "name": "fetchOHLCV",
      "params_doc": {
        "limit": "maximum candles to return",
        "params.until": "latest candle timestamp in milliseconds",
        "since": "earliest candle timestamp in milliseconds",
        "symbol": "Coinbase spot product such as ETH-USD",
        "timeframe": "one of 1m, 5m, 15m, 1h, 6h, or 1d"
      },
      "returns": {
        "description": "Candles ordered timestamp, open, high, low, close, volume",
        "type": "int[][]"
      },
      "signature": {
        "params": [
          {
            "default": null,
            "name": "symbol",
            "optional": false,
            "type": "string"
          },
          {
            "default": "1m",
            "name": "timeframe",
            "optional": true,
            "type": "string"
          },
          {
            "default": "undefined",
            "name": "since",
            "optional": true,
            "type": "Int"
          },
          {
            "default": "undefined",
            "name": "limit",
            "optional": true,
            "type": "Int"
          },
          {
            "default": "{}",
            "name": "params",
            "optional": true,
            "type": null
          }
        ],
        "return_type": "Promise<OHLCV[]>"
      },
      "unresolved_reason": null
    },
    "request": {
      "defaults": {
        "_omit": [
          "limit"
        ],
        "end": {
          "kind": "reference",
          "source": "until",
          "source_class": "optional",
          "transform": "milliseconds_to_rfc3339"
        },
        "granularity": {
          "kind": "reference",
          "source": "timeframe",
          "source_class": "unified_param"
        },
        "id": {
          "kind": "reference",
          "source": "symbol",
          "source_class": "unified_param"
        },
        "start": {
          "kind": "reference",
          "source": "since",
          "source_class": "optional",
          "transform": "milliseconds_to_rfc3339"
        }
      }
    },
    "parse": [
      "parseOHLCVs"
    ],
    "transaction_classification": {
      "on_chain": false,
      "transactional": false
    }
  },
