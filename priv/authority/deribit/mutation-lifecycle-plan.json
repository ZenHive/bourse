                "order_id"
              ]
            }
          },
          "expected": {
            "outcome": "success",
            "http_status": 200,
            "assertions": [
              {
                "path": [
                  "result",
                  "order_state"
                ],
                "equals": "cancelled"
              },
              {
                "path": [
                  "result",
                  "filled_amount"
                ],
                "equals": 0.0
              }
            ]
          },
          "evidence_semantics": "row_fields"
        },
        {
          "step_id": "final_state",
          "role": "final_state",
          "operation_id": "private/get_order_state",
          "authenticated": true,
          "params": {
            "order_id": {
              "bind": "order_id",
              "from_step": "place_order",
              "path": [
                "result",
                "order",
                "order_id"
              ]
            }
          },
          "expected": {
            "outcome": "success",
            "http_status": 200,
            "assertions": [
              {
                "path": [
                  "result",
                  "order_state"
                ],
                "equals": "cancelled"
              },
              {
                "path": [
                  "result",
                  "filled_amount"
                ],
                "equals": 0.0
              }
            ]
          },
          "evidence_semantics": "lifecycle_final_state"
        },
        {
          "step_id": "cancel_again",
          "role": "idempotent_final_state",
          "operation_id": "private/cancel",
          "authenticated": true,
          "params": {
            "order_id": {
              "bind": "order_id",
              "from_step": "place_order",
              "path": [
                "result",
                "order",
                "order_id"
              ]
            }
          },
          "expected": {
            "outcome": "documented_error",
            "http_status": 400,
            "error_code": 11044,
            "error_message": "not_open_order",
            "documented_meaning": "Attempt to do open order operations with the not open order.",
            "authority": "priv/authority/deribit/errors.json"
          },
          "evidence_semantics": "documented_error",
          "durable_state_effect": "none"
