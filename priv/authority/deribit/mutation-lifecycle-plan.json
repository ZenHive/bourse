              "from_step": "setup_ticker",
              "path": [
                "result",
                "best_bid_price"
              ],
              "tick_from_step": "setup_instrument",
              "tick_path": [
                "result",
                "tick_size"
              ]
            }
          },
          "expected": {
            "outcome": "documented_error",
            "http_status": 400,
            "error_code": -32602,
            "error_message": "Invalid params",
            "error_data": {
