  "request_seed_policy": "The provider's published private/buy example is a market order whose example response is not paired to it. No provider example is executed. Every request below is a separately reviewed parameter set chosen so the order cannot fill.",
  "lifecycles": [
    {
      "lifecycle_id": "order_place_cancel",
      "operation_id": "private/buy",
      "reversal_operation_id": "private/cancel",
      "instrument_name": "BTC-PERPETUAL",
      "review": {
        "classification": "reviewed",
        "decision": "approved",
        "reviewed_at": "2026-08-14",
        "rationale": "A post-only limit buy priced at half the best bid cannot cross the book, so the provider's documented placement effect is resting order state and nothing else. private/cancel removes that exact order id, and the provider documents no residue once an order is cancelled, so the account returns to its pre-lifecycle state inside one session.",
        "cleanup_operation_id": "private/cancel",
        "cleanup_failure_handling": "raise"
      },
      "steps": [
        {
          "step_id": "setup_instrument",
          "role": "setup",
          "operation_id": "public/get_instrument",
          "authenticated": false,
          "params": {
            "instrument_name": "BTC-PERPETUAL"
          },
          "expected": {
            "outcome": "success",
            "http_status": 200,
            "assertions": [
              {
                "path": [
                  "result",
                  "instrument_name"
                ],
                "equals": "BTC-PERPETUAL"
              },
              {
                "path": [
                  "result",
                  "tick_size"
                ],
                "equals": 0.5
              },
              {
                "path": [
                  "result",
                  "min_trade_amount"
                ],
                "equals": 10.0
              }
            ]
          },
          "evidence_semantics": "lifecycle_setup"
        },
        {
          "step_id": "setup_ticker",
          "role": "setup",
          "operation_id": "public/ticker",
          "authenticated": false,
          "params": {
            "instrument_name": "BTC-PERPETUAL"
          },
          "expected": {
            "outcome": "success",
            "http_status": 200,
            "assertions": [
              {
                "path": [
                  "result",
                  "instrument_name"
                ],
                "equals": "BTC-PERPETUAL"
              }
            ]
          },
          "evidence_semantics": "lifecycle_setup"
        },
        {
          "step_id": "place_order",
          "role": "act",
          "operation_id": "private/buy",
          "authenticated": true,
          "params": {
            "instrument_name": "BTC-PERPETUAL",
            "amount": "10",
            "type": "limit",
            "time_in_force": "good_til_cancelled",
            "post_only": "true",
            "label": {
              "bind": "session_label"
            },
            "price": {
              "bind": "unfillable_bid",
              "from_step": "setup_ticker",
              "path": [
                "result",
                "best_bid_price"
              ],
              "tick_from_step": "setup_instrument",
              "tick_path": [
                "result",
                "tick_size"
              ]
            }
          },
          "expected": {
            "outcome": "success",
            "http_status": 200,
            "assertions": [
              {
                "path": [
                  "result",
                  "order",
                  "order_state"
                ],
                "equals": "open"
              },
              {
                "path": [
                  "result",
                  "order",
                  "direction"
                ],
                "equals": "buy"
              },
              {
                "path": [
                  "result",
                  "order",
                  "order_type"
                ],
                "equals": "limit"
              },
              {
                "path": [
                  "result",
                  "order",
                  "post_only"
                ],
                "equals": true
              },
              {
                "path": [
                  "result",
                  "order",
                  "filled_amount"
                ],
                "equals": 0.0
              },
              {
                "path": [
                  "result",
                  "order",
                  "instrument_name"
                ],
                "equals": "BTC-PERPETUAL"
              }
            ]
          },
          "evidence_semantics": "row_fields"
        },
        {
          "step_id": "observe_open",
          "role": "observe",
          "operation_id": "private/get_order_state",
          "authenticated": true,
          "params": {
            "order_id": {
              "bind": "order_id",
              "from_step": "place_order",
              "path": [
                "result",
                "order",
                "order_id"
              ]
            }
          },
          "expected": {
            "outcome": "success",
            "http_status": 200,
            "assertions": [
              {
                "path": [
                  "result",
                  "order_state"
                ],
                "equals": "open"
              },
              {
                "path": [
                  "result",
                  "filled_amount"
                ],
                "equals": 0.0
              }
            ]
          },
          "evidence_semantics": "lifecycle_observation"
        },
        {
