          "params": {
            "instrument_name": "BTC-PERPETUAL",
            "amount": "10",
            "type": "limit",
            "time_in_force": "good_til_cancelled",
            "post_only": "true",
            "label": {
              "bind": "session_label"
            },
            "price": {
